{
  "name": "playwright-cucumber-xray",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
"scripts": {
  "test": "cucumber-js --format json:reports/cucumber-report.json",
  "test:dry": "cucumber-js --dry-run",
  "test:smoke": "cucumber-js --tags \"@smoke\" --format json:reports/cucumber-report.json",
  "test:regression": "cucumber-js --tags \"@regression\" --format json:reports/cucumber-report.json",
  "test:cadastro": "cucumber-js --tags \"@cadastro and not @cadastro-real\" --format json:reports/cucumber-report.json",
  "test:cadastro:real": "cucumber-js --tags \"@cadastro-real\" --format json:reports/cucumber-report.json",
  "test:colaborador": "cucumber-js --tags \"@colaborador-cadastro\" --format json:reports/cucumber-report.json",
  "test:colaborador:real": "cucumber-js --tags \"@colaborador-cadastro\" --format json:reports/cucumber-report.json",
  "test:colaborador:preview": "cucumber-js --tags \"@colaborador-preview\" --format json:reports/cucumber-report.json",
  "test:colaborador:evento": "cucumber-js --tags \"@colaborador-evento\" --format json:reports/cucumber-report.json",
  "test:responsavel-fiscal": "cucumber-js --tags \"@responsavel-fiscal\" --format json:reports/cucumber-report.json",
  "xray:responsavel-fiscal": "ts-node scripts/xray/runResponsavelFiscalAndPublish.ts"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2"
  }
}


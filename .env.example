# Defina como "true" SOMENTE quando tiver permissão para criar cadastro real.
CADASTRO_REAL=true

# Credenciais do painel (login.feature e colaborador.feature).
# EMAIL_LOGIN=
# PASSWORD_LOGIN=

# Pausa entre campos do colaborador (ms). Aumente se o painel estiver lento (ex: 1000).
COLABORADOR_PAUSA_MS=600

# Opcional: regex customizado para localizar o e-mail (assunto ou remetente).
# MAILINATOR_EMAIL_PATTERN=apponte
